# Préfixe des commandes
PREFIX=/
# Dossier de la session WhatsApp (à placer sur un volume persistant en hébergement)
AUTH_DIR=./auth
# Optionnel : numéro du bot (indicatif inclus, sans +) pour se lier par code au lieu du QR
# PAIRING_NUMBER=237600000000

# Comment les rôles sont envoyés en privé :
#  photo = image normale, supprimée automatiquement après ROLE_SELF_DESTRUCT secondes (recommandé)
#  image = carte à vue unique (ne fonctionne pas sur tous les comptes : à tester avec /imposteur test)
#  text  = message texte, supprimé automatiquement après ROLE_SELF_DESTRUCT secondes
# Pas sûr de ce qui fonctionne chez toi ? Tape /imposteur test dans le groupe.
ROLE_DELIVERY=photo
# Suppression automatique du message de rôle (pour tout le monde), en secondes. 0 = jamais.
# Défaut : 0 en mode image, 90 en modes photo et text. Plus c'est court, plus c'est équitable (ex. 45).
ROLE_SELF_DESTRUCT=60
# Efface la conversation privée côté bot juste après l'envoi d'un rôle
WIPE_DM_CHAT=true