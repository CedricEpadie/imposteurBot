# Préfixe des commandes
PREFIX=/
# Dossier de la session WhatsApp (à placer sur un volume persistant en hébergement)
AUTH_DIR=./auth
# Optionnel : numéro du bot (indicatif inclus, sans +) pour se lier par code au lieu du QR
# PAIRING_NUMBER=237600000000

# Équité : comment les rôles sont envoyés en privé
#  image (défaut) = carte à vue unique, l'hébergeur du bot ne peut pas la rouvrir
#  text           = message texte (visible par l'hébergeur du bot : moins équitable)
ROLE_DELIVERY=image
# Efface la conversation privée côté bot juste après l'envoi d'un rôle
WIPE_DM_CHAT=false