# Préfixe des commandes
PREFIX=/
# Dossier de la session WhatsApp (à placer sur un volume persistant en hébergement)
AUTH_DIR=./auth
# Optionnel : numéro du bot (indicatif inclus, sans +) pour se lier par code au lieu du QR
# PAIRING_NUMBER=237600000000

# Comment les rôles sont envoyés en privé :
#  photo = image normale, supprimée automatiquement après ROLE_SELF_DESTRUCT secondes (recommandé)
#  image = carte à vue unique (ne fonctionne pas sur tous les comptes : à tester avec /imposteur test)
#  text  = message texte, supprimé automatiquement après ROLE_SELF_DESTRUCT secondes
# Pas sûr de ce qui fonctionne chez toi ? Tape /imposteur test dans le groupe.
ROLE_DELIVERY=photo
# Suppression automatique du message de rôle (pour tout le monde), en secondes. 0 = jamais.
# Défaut : 0 en mode image, 90 en modes photo et text. Plus c'est court, plus c'est équitable (ex. 45).
ROLE_SELF_DESTRUCT=60
# Efface la conversation privée côté bot juste après l'envoi d'un rôle
WIPE_DM_CHAT=true

# Données persistantes : base SQLite (scores, stats, parties en cours) et packs de mots ajoutés.
# En hébergement, place ce dossier sur un volume persistant (comme AUTH_DIR).
DATA_DIR=./data
# Clé de chiffrement de l'état des parties en base (mot secret, imposteurs). Recommandé : une longue phrase au hasard,
# gardée hors du dossier de données. Sans elle, une clé est créée dans DATA_DIR/.state-key. Si tu la changes, les parties en cours sont perdues.
# STATE_KEY=une-longue-phrase-secrete-au-hasard
# Nombre de sauvegardes quotidiennes de la base conservées (0 = aucune)
BACKUP_KEEP=7
# Surveillance externe (facultatif) : adresse « push » d'Uptime Kuma / Healthchecks.io. Le bot l'appelle chaque minute tant
# qu'il est connecté ; si ça s'arrête (serveur éteint, bot planté), le service t'alerte. Voir docs/DEPLOIEMENT.md.
# HEALTHCHECK_URL=https://uptime.exemple.com/api/push/xxxxxxxx?status=up
# Rendus d'images simultanés (les autres attendent leur tour : protège la mémoire quand plusieurs groupes jouent). Défaut : 2
# RENDER_CONCURRENCY=2
# Thème saisonnier des images : auto (Halloween du 15 oct au 2 nov, Noël du 1er déc au 6 janv), noel, halloween ou none
# THEME=auto
# Numéros autorisés à ajouter des mots et à effacer les scores (indicatif inclus, sans +, séparés par des virgules).
# Le compte du bot lui-même est toujours admin.
# ADMIN_NUMBERS=237600000001,237600000002
