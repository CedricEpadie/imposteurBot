{
  "name": "imposteur-bot",
  "version": "1.11.0",
  "description": "Bot WhatsApp du jeu de l'Imposteur (mot secret, indices, vote)",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node index.js",
    "start": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop imposteur",
    "restart": "pm2 restart imposteur",
    "delete": "pm2 delete imposteur",
    "logs": "pm2 logs imposteur",
    "status": "pm2 status",
    "smoke": "node scripts/smoke.js",
    "loadtest": "node --import ./test/register-real-render.mjs scripts/loadtest.mjs",
    "restore": "node scripts/restore.js",
    "test": "node --import ./test/register.mjs --test --test-concurrency=1 test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "9.14.0",
    "pm2": "5.4.3",
    "qrcode-terminal": "0.12.0",
    "sharp": "0.33.5"
  }
}
